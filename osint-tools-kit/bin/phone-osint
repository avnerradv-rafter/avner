#!/usr/bin/env bash
# Phone OSINT Framework local launcher (per-case results, loopback web UI).
set -euo pipefail
APP="${PHONE_OSINT_HOME:-$HOME/tools/phone-osint-framework}"
PY="$APP/.venv/bin/python"; [[ -x "$PY" ]] || PY="$APP/.venv/Scripts/python.exe"  # Linux/macOS or Windows (Git Bash)
CASES="${OSINT_CASES_DIR:-$HOME/osint-cases}"
PIDF="${XDG_STATE_HOME:-$HOME/.local/state}/phone-osint-web.pid"
KEYS="NUMVERIFY_API_KEY SERPAPI_KEY GOOGLE_API_KEY GOOGLE_CSE_ID TWILIO_SID TWILIO_AUTH_TOKEN HUNTER_API_KEY HAVEIBEENPWNED_API_KEY WHITEPAGES_API_KEY SHODAN_KEY OPENCELLID_API_KEY"
safe_case() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { echo "ERROR: case id must match [A-Za-z0-9._-]+" >&2; exit 2; }; }

config_status() {  # prints key NAMES only, never values
  local env="$APP/config/.env"
  if [[ ! -f "$env" ]]; then echo "config: MISSING $env (template: $APP/config/.env.example)"; return 1; fi
  "$PY" - "$env" $KEYS <<'P'
import sys
from dotenv import dotenv_values
v=dotenv_values(sys.argv[1])
for k in sys.argv[2:]:
    x=(v.get(k) or '').strip()
    ok = bool(x) and not x.startswith('your_')
    print(f"  {k:24} {'set' if ok else 'MISSING'}")
P
}

case "${1:-help}" in
  check) config_status || true ;;
  validate)  # offline: parse/format only, no network
    "$PY" -c 'import sys,phonenumbers as p,phonenumbers.geocoder as g,phonenumbers.carrier as c
n=p.parse(sys.argv[1],None); print({"valid":p.is_valid_number(n),"e164":p.format_number(n,p.PhoneNumberFormat.E164),"country":g.description_for_number(n,"en"),"prefix_carrier(offline db)":c.name_for_number(n,"en"),"type":p.number_type(n)})' "${2:?usage: phone-osint validate +<E.164>}" ;;
  run)
    CASE="${2:?usage: phone-osint run <case-id> +<E.164> [identity_json]}"; NUM="${3:?phone number required}"; safe_case "$CASE"
    [[ "$NUM" =~ ^\+[0-9]{7,15}$ ]] || { echo "ERROR: number must be E.164, e.g. +9725XXXXXXXX" >&2; exit 2; }
    OUT="$CASES/$CASE/phone-osint"; mkdir -p "$OUT"
    echo "Configuration:"; config_status || echo "WARNING: running without API keys - only keyless modules will return data."
    cd "$APP"; PHONE_OSINT_RESULTS_DIR="$OUT" "$PY" phone_osint_master.py "$NUM" ${4:+"$4"}
    echo "Results: $(ls -dt "$OUT"/*_"$NUM" | head -1)" ;;
  web)
    CASE="${2:?usage: phone-osint web <case-id>}"; safe_case "$CASE"; PORT="${WEB_PORT:-5000}"
    if [[ -f "$PIDF" ]] && kill -0 "$(cat "$PIDF")" 2>/dev/null; then echo "Already running: http://127.0.0.1:$PORT"; exit 0; fi
    if "$PY" -c "import socket,sys;s=socket.socket();sys.exit(0 if s.connect_ex(('127.0.0.1',$PORT))==0 else 1)"; then echo "ERROR: port $PORT busy" >&2; exit 3; fi
    OUT="$CASES/$CASE/phone-osint"; mkdir -p "$OUT"; cd "$APP"
    PHONE_OSINT_RESULTS_DIR="$OUT" WEB_PORT="$PORT" nohup "$PY" web_interface.py >>"$OUT/web.log" 2>&1 & echo $! >"$PIDF"
    sleep 3; echo "Web UI: http://127.0.0.1:$PORT  (results: $OUT)" ;;
  web-stop) [[ -f "$PIDF" ]] && kill "$(cat "$PIDF")" 2>/dev/null; rm -f "$PIDF"; echo "stopped" ;;
  test) cd "$APP"; "$PY" -m pytest -q tests ;;
  *) echo "usage: phone-osint {check|validate <num>|run <case> <num> [identity_json]|web <case>|web-stop|test}"; exit 1 ;;
esac
