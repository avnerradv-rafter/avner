generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  phoneHash           String        @unique @map("phone_hash") @db.VarChar(64)
  passwordHash        String        @map("password_hash") @db.VarChar(256)
  totpSecret          Bytes?        @map("totp_secret")
  isVerified          Boolean       @default(false) @map("is_verified")
  accountStatus       AccountStatus @default(ACTIVE) @map("account_status")
  deletionScheduledAt DateTime?     @map("deletion_scheduled_at") @db.Timestamptz
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  lastActive          DateTime?     @map("last_active") @db.Timestamptz

  profile        Profile?
  medicalProfile MedicalProfile?
  sentMatches    Match[]        @relation("UserA")
  receivedMatches Match[]       @relation("UserB")
  sentMessages   Message[]      @relation("Sender")
  blocksGiven    Block[]        @relation("Blocker")
  blocksReceived Block[]        @relation("Blocked")
  reportsFiled   Report[]       @relation("Reporter")
  reportsReceived Report[]      @relation("Reported")
  contactBlocks  ContactBlock[]
  auditLogs      AuditLog[]
  signalPreKeys  SignalPreKey[]

  @@map("users")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
  PENDING_DELETION
}

model Profile {
  userId               String   @id @map("user_id") @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayNameEncrypted Bytes?   @map("display_name_encrypted")
  bioEncrypted         Bytes?   @map("bio_encrypted")
  birthYearEncrypted   Bytes?   @map("birth_year_encrypted")
  gender               String?  @db.VarChar(20)
  orientation          String?  @db.VarChar(30)
  lookingFor           String?  @map("looking_for") @db.VarChar(30)
  locationLatFuzzy     Decimal? @map("location_lat_fuzzy") @db.Decimal(6, 3)
  locationLngFuzzy     Decimal? @map("location_lng_fuzzy") @db.Decimal(6, 3)
  locationCity         String?  @map("location_city") @db.VarChar(100)
  profileCompleteness  Int      @default(0) @map("profile_completeness")
  visibilitySettings   Json?    @map("visibility_settings")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  photos               Photo[]

  @@map("profiles")
}

model MedicalProfile {
  userId                 String   @id @map("user_id") @db.Uuid
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  statusEncrypted        Bytes?   @map("status_encrypted")
  diagnosisYearEncrypted Bytes?   @map("diagnosis_year_encrypted")
  viralLoadEncrypted     Bytes?   @map("viral_load_encrypted")
  treatmentEncrypted     Bytes?   @map("treatment_encrypted")
  uEqualsUEncrypted      Bytes?   @map("u_equals_u_encrypted")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("medical_profiles")
}

model Photo {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  profile           Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  s3Key             String   @map("s3_key") @db.VarChar(500)
  encryptedPhotoKey Bytes    @map("encrypted_photo_key")
  orderIndex        Int      @default(0) @map("order_index")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("photos")
}

model Match {
  id         String      @id @default(uuid()) @db.Uuid
  userAId    String      @map("user_a_id") @db.Uuid
  userBId    String      @map("user_b_id") @db.Uuid
  userA      User        @relation("UserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB      User        @relation("UserB", fields: [userBId], references: [id], onDelete: Cascade)
  userALiked Boolean     @default(false) @map("user_a_liked")
  userBLiked Boolean     @default(false) @map("user_b_liked")
  matchedAt  DateTime?   @map("matched_at") @db.Timestamptz
  status     MatchStatus @default(PENDING)
  messages   Message[]

  @@unique([userAId, userBId])
  @@map("matches")
}

enum MatchStatus {
  PENDING
  MATCHED
  UNMATCHED
}

model Message {
  id          String      @id @default(uuid()) @db.Uuid
  matchId     String      @map("match_id") @db.Uuid
  match       Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId    String      @map("sender_id") @db.Uuid
  sender      User        @relation("Sender", fields: [senderId], references: [id])
  ciphertext  Bytes
  messageType MessageType @default(TEXT) @map("message_type")
  expiresAt   DateTime?   @map("expires_at") @db.Timestamptz
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  deliveredAt DateTime?   @map("delivered_at") @db.Timestamptz
  readAt      DateTime?   @map("read_at") @db.Timestamptz

  @@index([matchId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("messages")
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
  SYSTEM
}

model SignalPreKey {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyId     Int        @map("key_id")
  publicKey Bytes      @map("public_key")
  keyType   PreKeyType @map("key_type")
  isUsed    Boolean    @default(false) @map("is_used")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, keyId, keyType])
  @@map("signal_pre_keys")
}

enum PreKeyType {
  IDENTITY
  SIGNED
  ONE_TIME
}

model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  reason    String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([blockerId, blockedId])
  @@map("blocks")
}

model Report {
  id                   String         @id @default(uuid()) @db.Uuid
  reporterId           String         @map("reporter_id") @db.Uuid
  reportedId           String         @map("reported_id") @db.Uuid
  reporter             User           @relation("Reporter", fields: [reporterId], references: [id])
  reported             User           @relation("Reported", fields: [reportedId], references: [id])
  category             ReportCategory
  descriptionEncrypted Bytes?         @map("description_encrypted")
  evidenceEncrypted    Bytes?         @map("evidence_encrypted")
  status               ReportStatus   @default(PENDING)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt           DateTime?      @map("resolved_at") @db.Timestamptz
  resolvedBy           String?        @map("resolved_by") @db.VarChar(100)

  @@map("reports")
}

enum ReportCategory {
  HARASSMENT
  BLACKMAIL
  FAKE_PROFILE
  STIGMA
  SPAM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

model ContactBlock {
  userId            String @map("user_id") @db.Uuid
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactPhoneHash  String @map("contact_phone_hash") @db.VarChar(64)

  @@id([userId, contactPhoneHash])
  @@map("contact_blocks")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  action    String   @db.VarChar(50)
  ipHash    String?  @map("ip_hash") @db.VarChar(64)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_log")
}
