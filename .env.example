# Database
DATABASE_URL=postgresql://safeconnect:password@localhost:5432/safeconnect
REDIS_URL=redis://localhost:6379

# Auth — Generate with: openssl genrsa -out private.pem 2048
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption — Generate with: openssl rand -hex 32
SERVER_ENCRYPTION_KEY=GENERATE_ME_openssl_rand_hex_32
PHONE_HASH_SECRET=GENERATE_ME_openssl_rand_hex_32
IP_HASH_SECRET=GENERATE_ME_openssl_rand_hex_32

# SMS Provider (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# S3 Storage (AWS)
S3_BUCKET=safeconnect-media-dev
S3_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Monitoring
SENTRY_DSN=

# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:19006

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
